<?xml version='1.0' encoding='utf-8' ?>
<odoo>
    <record model="ir.ui.view" id="se_backend_form_view">
        <field name="model">se.backend</field>
        <field name="inherit_id" ref="connector_search_engine.se_backend_form_view" />
        <field name="arch" type="xml">
            <group name="se-main" position="after">
                <group name="elasticsearch" invisible="backend_type != 'elasticsearch'">
                    <field
                        name="es_server_host"
                        string="Host"
                        placeholder="http://elastic:9200"
                        required="backend_type == 'elasticsearch'"
                    />
                    <field name="auth_type" />
                    <field
                        string="User"
                        name="es_user"
                        invisible="auth_type != 'http'"
                    />
                    <field
                        string="Password"
                        name="es_password"
                        invisible="auth_type != 'http'"
                        password="1"
                    />
                    <field string="SSL" name="ssl" invisible="auth_type != 'http'" />
                    <field
                        string="API key ID"
                        name="api_key_id"
                        invisible="auth_type != 'api_key'"
                    />
                    <field
                        string="API key"
                        name="api_key"
                        invisible="auth_type != 'api_key'"
                    />
                </group>
                <group name="se-params">
                    <field string="Max retries" name="es_max_retries" />
                    <field string="Retry on timeout" name="es_retry_on_timeout" />
                    <field string="Timeout" name="es_timeout" />
                </group>
            </group>
        </field>
    </record>
</odoo>
